# ── review-server (backend) ────────────────────────────────────────────
# Copy to review-server/.env (never commit real values).

# Secret used to authorize /admin and /api/admin/* (Bearer token).
# Generate: openssl rand -hex 32
REVIEW_ADMIN_TOKEN=

# SQLite file location (WAL mode; back this file up).
REVIEW_DB_PATH=./review.db

# Exact origins allowed to call the public API (comma separated).
REVIEW_ALLOWED_ORIGINS=https://sukoonnest.live,https://www.sukoonnest.live

# Set to 1 ONLY when running behind a proxy that sets X-Forwarded-For
# (Render/Fly/Railway). Never trust XFF from clients directly.
REVIEW_TRUST_PROXY=

# Optional anti-spam tuning (defaults: 5 per IP per hour).
REVIEW_RATE_MAX=5
REVIEW_RATE_WINDOW_MS=3600000

# ── website frontend (GitHub Pages build) ─────────────────────────────
# Public build-time value — the deployed URL of review-server (no secrets).
# In the repo: Settings → Secrets and variables → Actions → variable REVIEW_API_URL
# (wired into .github/workflows/pages.yml as VITE_REVIEW_API_URL).
VITE_REVIEW_API_URL=https://REPLACE-WITH-YOUR-REVIEW-SERVER-URL
